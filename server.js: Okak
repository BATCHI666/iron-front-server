    const tmp = SOCIAL_DB + ".tmp";
    fs.writeFileSync(tmp,JSON.stringify(data),"utf8"); fs.renameSync(tmp,SOCIAL_DB);
  } catch(e) { console.error("Не удалось сохранить социальные данные:",e.message); }
}
