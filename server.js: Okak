wss.on("connection",(ws,req)=>{
  const id=randomUUID(),c={id,ws,name:"Игрок_"+id.slice(0,4),gameId:null,roomId:null,player:null,activity:"В меню",playTimeUpdatedAt:Date.now(),userAgent:String(req?.headers?.["user-agent"]||""),requestHeaders:{"cf-ipcountry":req?.headers?.["cf-ipcountry"],"x-vercel-ip-country":req?.headers?.["x-vercel-ip-country"],"x-vercel-ip-country-region":req?.headers?.["x-vercel-ip-country-region"]}};
  clients.set(id,c);ws.isAlive=true;ws.on("pong",()=>ws.isAlive=true);
  send(ws,{type:"welcome",id,name:c.name});sendRooms(ws);
  ws.on("message",raw=>{try{handleMessage(c,JSON.parse(raw.toString()));}catch(e){console.error("Ошибка обработки сообщения:",e.message);sendError(c,"Не удалось обработать сообщение.");}});
